{
  "compilerOptions": {
    "target": "es6",
    "module": "preserve",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "types": ["astro"],
    "moduleResolution": "bundler"
  },
  "include": ["src/**/*", "./worker-configuration.d.ts"],
  "exclude": ["node_modules", "**/*.spec.ts"]
}
