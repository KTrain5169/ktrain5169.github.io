---
import type { AstroComponentFactory } from "astro/runtime/server/render/astro/factory.js";
import SimpleIcon from "./SimpleIcon.astro";

const { platform, url, IconComponent, color = "white" } = Astro.props;
interface Props {
  platform: string;
  url: string;
  IconComponent: AstroComponentFactory;
  color?: string;
}
---

<a href={url} class="flex items-center gap-2 no-underline">
  <SimpleIcon IconComponent={IconComponent} size={24} color={color} />
  <span>{platform}</span>
</a>
