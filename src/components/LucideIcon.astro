---
import type { AstroComponent } from '@lucide/astro';
import type { AstroComponentFactory } from 'astro/runtime/server/render/astro/factory.js';

interface Props {
  IconComponent: AstroComponent;
  size: number;
  colour?: string;
  class?: string;
}

// Props passed to the LucideIcon component
const {
  IconComponent,
  size = 24,
  colour = "white",
  class: className,
} = Astro.props;
---

<IconComponent color={colour} size={size} class={className} />
