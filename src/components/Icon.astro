---
import * as SimpleIcons from "simple-icons-astro";

// Props passed to the Icon component
const { icon, size = 24, color = "white", ...props } = Astro.props;

// Helper type to restrict icon name to valid keys
type SimpleIconKeys = keyof typeof SimpleIcons;

const toPascalCase = (str: string) =>
  str.replace(/(^\w|-\w)/g, (match) => match.replace("-", "").toUpperCase());

const simpleIconMap = { ...SimpleIcons };
const simpleIconName = toPascalCase(icon); // Convert simpleIconNames to PascalCase
const SimpleIconComponent = simpleIconMap[simpleIconName as SimpleIconKeys];

// Handle the case when the icon is not found
if (!SimpleIconComponent) {
  throw new Error(`Simple icon ${icon} not found`);
}
---

<SimpleIconComponent color={color} size={size} {...props} />
